<?xml version="1.0" encoding="utf-8"?>
<!--
    Simplified globe icon for Globe TV launcher.
    A circle representing a globe with latitude/longitude lines.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer globe circle -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 A36,36 0 1,1 53.999,18 Z"
        android:strokeColor="#00bcd4"
        android:strokeWidth="3.5" />

    <!-- Vertical axis line -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 L54,90"
        android:strokeColor="#00bcd4"
        android:strokeWidth="2" />

    <!-- Horizontal equator -->
    <path
        android:fillColor="#00000000"
        android:pathData="M18,54 L90,54"
        android:strokeColor="#00bcd4"
        android:strokeWidth="2" />

    <!-- Upper latitude arc -->
    <path
        android:fillColor="#00000000"
        android:pathData="M22,38 Q54,30 86,38"
        android:strokeColor="#00bcd4"
        android:strokeWidth="1.5" />

    <!-- Lower latitude arc -->
    <path
        android:fillColor="#00000000"
        android:pathData="M22,70 Q54,78 86,70"
        android:strokeColor="#00bcd4"
        android:strokeWidth="1.5" />

    <!-- Left longitude arc -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 Q36,54 54,90"
        android:strokeColor="#00bcd4"
        android:strokeWidth="1.5" />

    <!-- Right longitude arc -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,18 Q72,54 54,90"
        android:strokeColor="#00bcd4"
        android:strokeWidth="1.5" />

</vector>
